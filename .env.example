# ==========================================
# CONFIGURAÇÕES DO EVENT-DRIVEN PAYMENT ENGINE
# ==========================================

# Banco de Dados PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/payments_db
SPRING_DATASOURCE_USERNAME=payment_user
SPRING_DATASOURCE_PASSWORD=payment_pass_local

# Mensageria Kafka / Redpanda
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Porta do Servidor
PORT=8080

# Limites de Memória JVM (Otimizado para instâncias enxutas / 8GB)
JAVA_TOOL_OPTIONS=-Xms128m -Xmx256m -XX:+UseG1GC
